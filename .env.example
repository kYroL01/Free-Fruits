# Supabase project credentials. EXPO_PUBLIC_ vars are inlined into the JS bundle at build time,
# so only the publishable (anon) key belongs here — never the service_role key.
# Copy to `.env` and fill in from Supabase Dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
